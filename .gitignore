# =============================================
# 코드 외 산출물 파일 제외
# =============================================

# 로그 파일
*.log
logs/

# 이미지 파일
*.png
*.jpg
*.jpeg
*.gif
*.bmp

# 엑셀 파일
*.xlsx
*.xls
*.csv

# HTML 출력 파일
*.html

# 출력/디버그 폴더
output/
debug/

# =============================================
# Python 관련 제외
# =============================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/

# =============================================
# IDE / 에디터 설정
# =============================================
.idea/
.vscode/
*.swp
*.swo
*~

# =============================================
# 운영체제 파일
# =============================================
.DS_Store
Thumbs.db

# Local credentials and environment secrets
config.json
.env
.env.*
!.env.example

# Website source
!web/*.html
